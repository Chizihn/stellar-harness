# OpenAI key for the demo chat at /api/chat.
OPENAI_API_KEY=
# OpenAI model the chat uses.
OPENAI_MODEL=gpt-4.1
# Postgres the web app reads and the worker writes (docker compose up gives this one).
DATABASE_URL=postgres://harness:harness@localhost:55432/harness
# Mainnet Soroban RPC the worker and scan CLI read from.
RPC_URL=https://mainnet.sorobanrpc.com
# Public mainnet account used as the source of fix cost simulations; nothing is ever signed or sent.
SIMULATION_SOURCE=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
